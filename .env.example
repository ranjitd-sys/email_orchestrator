# --- Orchestrator (Bun process) ---
# Hosted Postgres connection string. Local (docker compose): postgresql://email:email@localhost:5432/email_orchestrator
DATABASE_URL=postgresql://email:email@localhost:5432/email_orchestrator

# --- Cloudflare Queue (Bun pushes send jobs here via HTTP REST API) ---
# The queue itself is provisioned by Alchemy (apps/worker/alchemy.run.ts).
# After `bun run deploy` in apps/worker, take accountId + queueId from the
# deploy output and paste them here for the orchestrator.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
# API token with "Queues Edit" permission. Never commit a real token.
CLOUDFLARE_API_TOKEN=

# --- Email provider (set on the Worker via Alchemy env, not read by the orchestrator) ---
# One of: resend | brevo | mock. Change this single value to switch providers.
EMAIL_PROVIDER=resend
# Fill in whichever key matches EMAIL_PROVIDER.
RESEND_API_KEY=
BREVO_API_KEY=

# --- Local ---
PORT=3000