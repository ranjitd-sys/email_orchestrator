# --- Orchestrator (Bun process) ---
# Hosted Postgres connection string. Local: postgresql://user:pass@localhost:5432/email_orchestrator
DATABASE_URL=postgresql://user:password@host:5432/email_orchestrator

# --- Cloudflare Queue (Bun pushes send jobs here via HTTP REST API) ---
# The queue itself is provisioned by Alchemy (apps/worker/alchemy.run.ts).
# After `bun run deploy` in apps/worker, take accountId + queueId from the
# deploy output and paste them here for the orchestrator.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
# API token with "Queues Edit" permission. Never commit a real token.
CLOUDFLARE_API_TOKEN=

# --- Brevo ---
BREVO_API_KEY=

# --- Shared secret between the Worker and the orchestrator internal API ---
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- Local ---
PORT=3000