{
  "name": "@email/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "migrate": "bun run ../packages/db/src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "echo 'orchestrator deploys to your Bun host (systemd/PM2/Docker)' && exit 1"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0",
    "@effect/sql-pg": "^4.0.0",
    "@email/db": "workspace:*",
    "@email/shared": "workspace:*",
    "effect": "^4.0.0",
    "xstate": "^5.33.2"
  }
}